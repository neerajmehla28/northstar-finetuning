# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Model files and run outputs are committed deliberately, never by accident
*.pt
*.pth
*.safetensors
models/
outputs/

# Parked draft labels: not data, not for sharing without the data owner's sign-off
data/labels/

# Secrets
.env

# Downloaded zips of raw runs: their contents are committed unpacked (results/cv_*)
results/step*/*.zip

# Exception: the final LoRA router's trained add-ons and heads (about 1.2 MB per seed), needed to use the model
!results/step06/fine_tuned/balanced/*_trained_weights.pt
